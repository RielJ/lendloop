# Copy to n8n/.env, or run `just n8n-env`, which fills the secrets for you.
# Encrypts credentials stored in n8n. Back it up; losing it loses the credentials.
N8N_ENCRYPTION_KEY=
# Must equal LENDLOOP_WEBHOOK_SECRET in .env.local and in the Convex deployment.
LENDLOOP_WEBHOOK_SECRET=
# Where n8n reaches the Convex HTTP actions (the local backend's site port).
CONVEX_SITE_URL=http://host.docker.internal:3211
# Where the error workflow sends alerts.
ALERT_EMAIL=ops@lendloop.local
