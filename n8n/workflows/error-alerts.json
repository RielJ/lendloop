{
  "id": "LendLoopErrors01",
  "name": "LendLoop: error alerts",
  "active": false,
  "nodes": [
    {
      "parameters": {},
      "id": "error-trigger",
      "name": "Error Trigger",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// Alert without the failed run's payload: names the workflow, node and error only.\nconst { execution = {}, workflow = {}, trigger } = $input.first().json;\nconst error = execution.error ?? trigger?.error ?? {};\nreturn [{\n  json: {\n    to: $env.ALERT_EMAIL || 'ops@lendloop.local',\n    subject: `[LendLoop] ${workflow.name ?? 'A workflow'} failed`,\n    text: [\n      `Workflow: ${workflow.name ?? 'unknown'}`,\n      `Failed node: ${execution.lastNodeExecuted ?? error.node?.name ?? 'unknown'}`,\n      `Error: ${error.message ?? 'unknown error'}`,\n      execution.url ? `Execution: ${execution.url}` : 'Execution was not saved.',\n    ].join('\\n'),\n  },\n}];\n"
      },
      "id": "summarize-error",
      "name": "Summarize error",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "fromEmail": "LendLoop <noreply@lendloop.local>",
        "toEmail": "={{ $json.to }}",
        "subject": "={{ $json.subject }}",
        "emailFormat": "text",
        "text": "={{ $json.text }}",
        "options": {
          "appendAttribution": false
        }
      },
      "id": "alert-ops",
      "name": "Alert ops",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        440,
        0
      ],
      "credentials": {
        "smtp": {
          "id": "LendLoopMailpit1",
          "name": "Mailpit SMTP (local)"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    }
  ],
  "connections": {
    "Error Trigger": {
      "main": [
        [
          {
            "node": "Summarize error",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Summarize error": {
      "main": [
        [
          {
            "node": "Alert ops",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {},
  "tags": []
}
