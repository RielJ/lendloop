# Copy to .env.local. `bunx convex dev` fills the three Convex values on first run.
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=

# Clerk dashboard → API keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Shared HMAC secret for Convex <-> n8n. `just n8n-env` generates it if empty
# and copies it to n8n/.env and the Convex deployment.
LENDLOOP_WEBHOOK_SECRET=
